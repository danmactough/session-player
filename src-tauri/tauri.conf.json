{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Session Player",
  "version": "../package.json",
  "identifier": "com.danmactough.sessionplayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Session Player",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: spimg: http://spimg.localhost https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Dan MacTough"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QzM3RkRCOUE3MjY4RjMKUldUemFIS2EyMy9EU0JwdWpTNmZjTEJlajF1T3hhajNLN3NoNEx4NlV3SXFWaXpYNWdCMUh5V0gK",
      "endpoints": [
        "https://github.com/danmactough/session-player/releases/latest/download/latest.json"
      ]
    }
  }
}
